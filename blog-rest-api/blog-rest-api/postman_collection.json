{
  "info": {
    "name": "Blog REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Blog Post",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My First Blog Post\",\n  \"content\": \"This is the content of my blog post.\",\n  \"author\": \"Jane Doe\",\n  \"category\": \"Technology\"\n}"
        },
        "url": { "raw": "http://localhost:5000/posts", "host": ["localhost"], "port": "5000", "path": ["posts"] }
      }
    },
    {
      "name": "Get All Blog Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:5000/posts", "host": ["localhost"], "port": "5000", "path": ["posts"] }
      }
    },
    {
      "name": "Get Single Blog Post",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:5000/posts/1", "host": ["localhost"], "port": "5000", "path": ["posts", "1"] }
      }
    },
    {
      "name": "Update Blog Post",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Blog Post Title\"\n}"
        },
        "url": { "raw": "http://localhost:5000/posts/1", "host": ["localhost"], "port": "5000", "path": ["posts", "1"] }
      }
    },
    {
      "name": "Delete Blog Post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "http://localhost:5000/posts/1", "host": ["localhost"], "port": "5000", "path": ["posts", "1"] }
      }
    }
  ]
}
